   ],
   "parameters": {
    "jsCode": "const b = $json.body || {};\nconst allowed = ['ACCEPT', 'REJECT', 'REQUEST_MORE_INFORMATION'];\nconst caseId = String(b.case_id || '').match(/CASE-\\d{4}/);\nif (!caseId) throw new Error('Brak lub zly case_id w body');\nif (!allowed.includes(b.decision)) throw new Error('decision musi byc jednym z: ' + allowed.join(', '));\nreturn [{ json: {\n  case_id: caseId[0],\n  decision: b.decision,\n  note: String(b.note || ''),\n  decided_at: new Date().toISOString()\n} }];"
   }
  },
