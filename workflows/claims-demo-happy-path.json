  {
   "id": "parse-knowledge",
   "name": "Parse knowledge",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1200,
    0
   ],
   "parameters": {
    "jsCode": "const pol = $('Extract policies').first().json.data;\nconst pre = $('Extract precedents').first().json.data;\nreturn [{ json: { policies: pol.policies ?? pol, precedents: pre.precedent_cases ?? pre } }];"
   }
