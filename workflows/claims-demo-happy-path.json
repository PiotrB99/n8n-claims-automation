   "parameters": {
    "jsCode": "const r = $('Decision router').first().json.result;\nconst task = {\n  task: 'DECYZA CZLOWIEKA - reklamacja oczekuje na rozstrzygniecie',\n  case_id: r.case_id,\n  ai_recommendation: r.ai_recommendation,\n  confidence: r.confidence,\n  evidence: r.evidence,\n  missing_information: r.missing_information,\n  reasoning: r.reasoning,\n  order_value_pln: r.order_value_pln,\n  decided_at: r.decided_at,\n  mozliwe_decyzje: ['ACCEPT', 'REJECT', 'REQUEST_MORE_INFORMATION']\n};\nconst buf = Buffer.from(JSON.stringify(task, null, 1), 'utf8');\nconst bin = await this.helpers.prepareBinaryData(buf, r.case_id + '-task.json', 'application/json');\nreturn [{ json: { filename: r.case_id + '-task.json' }, binary: { data: bin } }];"
