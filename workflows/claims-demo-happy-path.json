  {
   "id": "parse-ai-output",
   "name": "Parse AI output",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1800,
    0
   ],
   "parameters": {
    "jsCode": "const item = $input.first().json;\nconst raw = (item.choices && item.choices[0] && item.choices[0].message && item.choices[0].message.content) || '';\nlet parsed = null;\ntry { parsed = JSON.parse(String(raw)); } catch (e) {}\nif (!parsed) {\n  const matches = String(raw).match(/\\{[^{}]*\\}/g) || [];\n  for (const cand of matches.reverse()) {\n    try { parsed = JSON.parse(cand); break; } catch (e) {}\n  }\n}\nif (!parsed || !parsed.recommendation) {\n  return [{ json: { ok: false, error: 'invalid structured output', raw: String(raw).slice(0, 500) } }];\n}\nconst conf = Number(parsed.confidence);\nparsed.confidence = Number.isFinite(conf) ? conf : 0;\nif (!Array.isArray(parsed.evidence)) parsed.evidence = [];\nif (!Array.isArray(parsed.missing_information)) parsed.missing_information = [];\nconst cfg = $('Config').first().json;\nreturn [{ json: { ok: true, ai: parsed, threshold: cfg.confidence_threshold } }];"
   }
  },
  {
   "id": "decision-router",
   "name": "Decision router",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2000,
    0
   ],
   "parameters": {
    "jsCode": "const cfg = $('Config').first().json;\nconst caseData = $('Parse case').first().json.case;\nconst ord = $('Assemble context').first().json.order;\nconst orderValue = ord ? ord.order_value_pln : null;\nconst r = $input.first().json;\nconst base = {\n  case_id: caseData.id,\n  ai_recommendation: r.ai ? r.ai.recommendation : null,\n  confidence: r.ai ? r.ai.confidence : null,\n  evidence: r.ai ? r.ai.evidence : [],\n  missing_information: r.ai ? r.ai.missing_information : [],\n  reasoning: r.ai ? r.ai.reasoning : null\n};\nlet final, why;\nif (!r.ok) { final = 'TECHNICAL_FAIL'; why = r.error; }\nelse if (orderValue !== null && orderValue > 2000) { final = 'HUMAN_REVIEW'; why = 'wartosc zamowienia ' + orderValue + ' zl ponad prog globalny 2000 zl (POL-06) - bramka determinystyczna'; }\nelse if (!['ACCEPT', 'REJECT', 'HUMAN_REVIEW'].includes(r.ai.recommendation)) { final = 'HUMAN_REVIEW'; why = 'AI zwrocilo nieznany typ rekomendacji'; }\nelse if (r.ai.recommendation === 'HUMAN_REVIEW') { final = 'HUMAN_REVIEW'; why = 'rekomendacja AI: HUMAN_REVIEW'; }\nelse if (r.ai.confidence < r.threshold) { final = 'HUMAN_REVIEW'; why = 'confidence ' + r.ai.confidence + ' < prog ' + r.threshold; }\nelse if (!r.ai.evidence.length) { final = 'HUMAN_REVIEW'; why = 'brak dowodow (evidence)'; }\nelse if (r.ai.missing_information.length) { final = 'HUMAN_REVIEW'; why = 'AI zglosilo brakujace informacje'; }\nelse { final = r.ai.recommendation; why = 'wystarczajace dowody i confidence >= prog'; }\nbase.order_value_pln = orderValue;\nbase.final_decision = final;\nif (!r.ok) base.raw_snippet = String(r.raw || '').slice(0, 500);\nbase.gate_reason = why;\nbase.model = cfg.model;\nbase.decided_at = new Date().toISOString();\nreturn [{ json: { result: base } }];"
   }
  },
