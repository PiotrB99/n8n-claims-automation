    "jsCode": "const lk = $('Order lookup').first().json;\nlet prior = null;\nfor (const it of $input.all()) {\n  if (it.json && typeof it.json.prior !== 'undefined') prior = it.json.prior;\n}\nreturn [{ json: { case: lk.case, order: lk.order, ord_ref: lk.ord_ref,\n  thread_case_id: lk.thread_case_id || null, prior: prior } }];"
